# Positive Telegram OIDC Client ID created in BotFather Web Login settings.
ASTRO_WEB_OIDC_CLIENT_ID=123456789

# Public rollout switch. true grants Astrodome to every authenticated Telegram
# user; false keeps it available only to ASTRO_TELEGRAM_ADMIN_IDS.
ASTRO_ASTRODOME_ENABLED=false

# Comma-separated numeric Telegram IDs. Empty + ASTRO_ASTRODOME_ENABLED=false
# denies Astrodome to everyone; use a non-real example in documentation only.
ASTRO_TELEGRAM_ADMIN_IDS=100000001

# Dedicated least-privilege PostgreSQL role; its password stays in
# ./secrets/web_db_password rather than this file.
ASTRO_WEB_DB_USER=bot_astrosferum_web
