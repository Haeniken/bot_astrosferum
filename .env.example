# Optional Horizon switch and shared Overall/Horizon calibration. Bundled
# Compose always injects these values, so .env overrides config.yaml there;
# direct execution falls back to YAML when the corresponding variable is absent.
# Changing ASTRO_OVERALL_* or ASTRO_CLOUD_* also changes Horizon cache identity.
ASTRO_HORIZON_ANALYSIS_ENABLED=true
# ICON-EU-only 72-hour interactive Astrodome on astrosferum.com. true grants
# access to every authenticated Telegram user; false keeps admin preview for
# ASTRO_TELEGRAM_ADMIN_IDS. It is a rollout switch, not a worker kill switch.
ASTRO_ASTRODOME_ENABLED=true
ASTRO_COPERNICUS_DEM_GLO30_ENABLED=true
# Bounded local cache of immutable GLO-30 GeoTIFF tiles. One 60 km skyline may
# touch several 1x1 degree tiles; 20 GiB leaves room for many observing areas.
ASTRO_COPERNICUS_DEM_CACHE_LIMIT=20GiB
# Native ICON-EU column footprint retained in RAM for one Astrodome job.
# Keep below the directional worker's hard container memory limit.
ASTRO_ASTRODOME_RESIDENT_LIMIT=10GiB
# 0s keeps a live Astrodome calculation free from an artificial wall-clock
# cutoff. Explicit cancellation and process shutdown remain effective.
ASTRO_ASTRODOME_JOB_TIMEOUT=0s
# 0s disables the internal bot -> worker HTTP deadline. Keep it disabled when
# ASTRO_ASTRODOME_JOB_TIMEOUT is disabled.
ASTRO_DIRECTIONAL_INTERNAL_REQUEST_TIMEOUT=0s
# One shared bounded FIFO for waiting Horizon and Astrodome tasks.
ASTRO_DIRECTIONAL_QUEUE_SIZE=8
# Shared active Horizon + Astrodome calculations. Each Astrodome slot can use
# the full resident limit below, so keep 1 until the complete cgroup footprint
# is benchmarked. Bot, worker, and operator CLI must use the same value (1..32).
ASTRO_DIRECTIONAL_CONCURRENCY=1
# Docker hard limit includes Go, CDO/ecCodes children, and charged file cache.
# The 32g production headroom covers an observed 18.53 GB peak without cgroup
# pressure; a 24 GiB trial reached its hard boundary. It is not a scientific
# constant or a measured minimum. Repeat the resource gate before reducing it.
ASTRO_DIRECTIONAL_WORKER_MEMORY_LIMIT=32g
ASTRO_DIRECTIONAL_WORKER_GOMEMLIMIT=12GiB
# The production cold-run benchmark showed that four CPUs make the complete
# dense 72-frame calculation approach three hours. Ten leaves two logical
# CPUs on the 12-thread host for model sync and ordinary bot forecasts; repeat
# the non-regression measurements after a host or workload change.
ASTRO_DIRECTIONAL_WORKER_CPU_LIMIT=10.00
# Optional independent NASA GEOS-CF AOD550/ozone enrichment for the
# Reference V-band diagnostic. Forecast delivery remains fail-open when false
# or when NASA is temporarily unavailable.
ASTRO_GEOS_CF_ENABLED=true
# Shared limit for simultaneously calculated ordinary forecasts across Telegram
# and VK. Further requests wait and receive their queue position.
ASTRO_FORECAST_CONCURRENCY=2
# Optional combined ICON-EU + ICON Global network limit in decimal Mbit/s.
# Leave commented for unlimited downloads.
# ASTRO_ICON_DOWNLOAD_LIMIT_MBIT=100
ASTRO_OVERALL_SEEING_WEIGHT=1.0
ASTRO_OVERALL_CLOUD_WEIGHT=2.0
ASTRO_OVERALL_COHERENCE_TIME_WEIGHT=0.25
# Maximum loss caused by the combined seeing/tau0 utility term. Physical
# epsilon and tau0 diagnostics remain unchanged.
ASTRO_OVERALL_OPTICAL_TURBULENCE_MAX_PENALTY=0.25
ASTRO_OVERALL_POSSIBLE_FOG_FACTOR=0.75
ASTRO_OVERALL_HIGH_FOG_FACTOR=0.10
# Binary operational veto threshold for hourly precipitation (mm). This is a
# detection threshold; precipitation intensity is not mapped to a soft score.
ASTRO_OVERALL_PRECIPITATION_DETECT_MM=0.05
ASTRO_OVERALL_GOOD_SEEING_ARCSEC=0.5
ASTRO_OVERALL_BAD_SEEING_ARCSEC=2.0
ASTRO_OVERALL_BEST_COHERENCE_TIME_MS=5.2
ASTRO_OVERALL_BAD_COHERENCE_TIME_MS=1.6
ASTRO_OVERALL_BOUNDARY_LAYER_MIN_M=500
ASTRO_OVERALL_BOUNDARY_LAYER_TOP_M=2000
ASTRO_OVERALL_GROUND_CN2_SCALE=1.0
# Low-cloud CLC uncertainty guard; middle/high use 55%/18% of this value.
ASTRO_OVERALL_UNRESOLVED_CLOUD_OBSTRUCTION=0.45
ASTRO_OVERALL_SURFACE_WIND_MAX_PENALTY=0.20
ASTRO_OVERALL_SURFACE_WIND_START_MS=8.5
ASTRO_OVERALL_SURFACE_WIND_FULL_MS=15.0
ASTRO_OVERALL_SURFACE_GUST_START_MS=12.0
ASTRO_OVERALL_SURFACE_GUST_FULL_MS=22.0
ASTRO_CLOUD_LIQUID_RADIUS_MICROMETERS=10
ASTRO_CLOUD_ICE_RADIUS_MICROMETERS=25

# Explicitly selected, operator-verified David Lorenz Light Pollution Atlas.
# It is never advanced automatically.
ASTRO_LIGHT_POLLUTION_ATLAS_YEAR=2024
POSTGRES_DB=bot_astrosferum
POSTGRES_USER=bot_astrosferum
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Comma-separated numeric Telegram IDs. When public Astrodome access is false,
# an empty list denies Astrodome to everyone.
ASTRO_TELEGRAM_ADMIN_IDS=
# Comma-separated numeric VK user IDs. Empty disables the VK admin UI.
ASTRO_VK_ADMIN_IDS=
